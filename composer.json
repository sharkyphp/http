{
    "name": "sharkyphp/http",
    "description": "SharkyPHP http, PSR-7 HTTP message and server request handling.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sharky\\Http\\": "src"
        }
    },
    "extra": {
        "sharky-config": "sharky-config.php"
    },
    "authors": [
        {
            "name": "bytesharky",
            "email": "fish@doffish.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "sharkyphp/annotation": "^2.0.0",
        "sharkyphp/container": "^2.0.0",
        "sharkyphp/contracts": "^2.0.0",
        "sharkyphp/facade": "^2.0.0",
        "sharkyphp/pipeline": "^2.0.0",
        "sharkyphp/support": "^2.0.0"
    },
    "archive": {
        "exclude": [
            "docs/",
            "tests/",
            ".github/",
            ".gitignore",
            "composer.lock",
            "vendor/",
            ".env"
        ]
    }
}
